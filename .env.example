# Copy to the ignored root .env file and fill only what you are using.
# Never commit .env or place server secrets in EXPO_PUBLIC_* variables.

# ── Local API and database ──────────────────────────────────────────────
NODE_ENV=development
PORT=8787

# Neon Console → Project → Connect. Use the pooled Node.js connection URL.
# SERVER ONLY. Keep the entire URL private.
DATABASE_URL=

# Generate with: openssl rand -base64 32
# SERVER ONLY. Used by Better Auth to sign and encrypt sessions.
AUTH_SECRET=

# API origin, without a trailing slash. For a phone on your Wi-Fi, use the
# computer's LAN address, for example http://192.168.1.20:8787.
AUTH_BASE_URL=

# Usually leave blank: the server trusts the healthcare:// app scheme and
# local development origins. Add comma-separated exact origins only if needed.
AUTH_TRUSTED_ORIGINS=

# Generate with: openssl rand -hex 32
# SERVER/WORKER ONLY. Needed when the private background-job worker is enabled.
JOB_DISPATCH_SECRET=

# ── AI features (needed when photo and planning phases are enabled) ─────
# OpenRouter → Keys. SERVER ONLY. Never add an EXPO_PUBLIC_ prefix.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Healthcare
AI_MODEL=minimax/minimax-m3
AI_MONTHLY_BUDGET_USD=
AI_MAX_OUTPUT_TOKENS=1200
AI_MAX_PHOTO_BYTES=10485760

# ── Private image storage (fill after choosing an S3-compatible provider) ─
# Keep these blank until the private-upload provider is selected.
STORAGE_PROVIDER=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=false
UPLOAD_MAX_BYTES=10485760

# Generate with: openssl rand -hex 32
# SERVER ONLY. Used later to encrypt stored OAuth refresh tokens.
TOKEN_ENCRYPTION_KEY=

# ── Optional food-data import ────────────────────────────────────────────
# Needed only if importing from USDA FoodData Central; manual catalog work
# does not need this key.
USDA_API_KEY=

# ── Google Calendar (optional; configure in the Calendar phase) ─────────
# Google Cloud Console → OAuth credentials. The client secret stays server-side.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ── Email delivery (optional; only needed if email verification/reset is added) ─
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
