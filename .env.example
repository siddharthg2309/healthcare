# Blank configuration reference for the planned application.
# No runtime consumes this file yet. Keep real values in ignored local files
# or the deployment provider's secret manager, never in this example.
# Split these variables into backend/mobile examples when those apps exist.

# SERVER ONLY: Postgres, identity, storage, and background jobs.
DATABASE_URL=
AUTH_SECRET=
AUTH_BASE_URL=
STORAGE_BUCKET=
TOKEN_ENCRYPTION_KEY=
JOB_DISPATCH_SECRET=

# SERVER ONLY: chosen model and credentials.
OPENROUTER_API_KEY=
AI_MODEL=minimax/minimax-m3

# SERVER ONLY: optional Google Calendar and catalog-import configuration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
USDA_API_KEY=

# PUBLIC MOBILE CONFIG: readable in a built APK; never put secrets here.
EXPO_PUBLIC_API_BASE_URL=
