#!/bin/sh
set -eu

if ! command -v python3 >/dev/null 2>&1; then
  printf '%s\n' 'Python 3 is required for repository filename checks.' >&2
  exit 1
fi

if ! command -v gitleaks >/dev/null 2>&1; then
  printf '%s\n' 'Gitleaks is required. Install it with: brew install gitleaks' >&2
  exit 1
fi

python3 scripts/check-tracked-files.py --staged
exec gitleaks git --pre-commit --staged --redact --no-banner
