{
  "name": "@healthcare/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "start": "tsx src/dev.ts",
    "migrate:auth": "auth migrate --config src/auth/config.ts --yes",
    "migrate:langgraph": "tsx scripts/migrate-langgraph.ts",
    "invite:create": "tsx scripts/create-invitation.ts",
    "catalog:search": "tsx scripts/catalog-foods.ts search",
    "catalog:import": "tsx scripts/catalog-foods.ts import",
    "catalog:publish": "tsx scripts/catalog-foods.ts publish",
    "catalog:aliases": "tsx scripts/catalog-foods.ts aliases",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts --config eslint.config.cjs"
  },
  "dependencies": {
    "@healthcare/contracts": "*",
    "@healthcare/database": "*",
    "@hono/node-server": "^1.19.5",
    "@langchain/langgraph": "^1.5.1",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.0",
    "better-auth": "^1.7.0",
    "dotenv": "^16.6.1",
    "hono": "^4.10.6",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.3",
    "auth": "^1.7.12",
    "eslint": "^9.39.5",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
