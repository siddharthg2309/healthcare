    "hono": "^4.10.6",
    "dotenv": "^16.6.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "auth": "^1.7.12",
    "@types/node": "^22.19.3",
    "eslint": "^9.39.5",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3"
  }
}
