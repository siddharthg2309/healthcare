# Copy to apps/mobile/.env for local Expo runs. These are public URLs, not secrets.
# The WebView loads the deployed or local Next.js app from this origin.
# For a physical Android phone, use your computer's LAN address, not localhost.
# Example: http://192.168.1.20:3000
EXPO_PUBLIC_APP_URL=
# The native auth/API client uses the same origin in production.
# Example: http://192.168.1.20:3000
EXPO_PUBLIC_API_BASE_URL=
