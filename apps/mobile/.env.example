# Copy to apps/mobile/.env for local Expo runs. This is a public URL, not a secret.
# The WebView loads the deployed or local Next.js app from this origin.
# Production APKs require a public HTTPS hostname; localhost and LAN URLs are development-only.
# For a physical Android phone, use your computer's LAN address, not localhost.
# Example: http://192.168.1.20:3000
EXPO_PUBLIC_APP_URL=
