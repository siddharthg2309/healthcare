{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "production": {
      "environment": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "extends": "production",
      "environment": "preview"
    },
    "development": {
      "extends": "production",
      "environment": "development",
      "developmentClient": true
    }
  }
}
